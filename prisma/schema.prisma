// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Modèle Utilisateur
// ============================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  password      String
  displayName   String?
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  memberships   LeagueMembership[]
  ownedLeagues  League[]           @relation("LeagueOwner")
  matchPlayers  MatchPlayer[]
  eloRatings    EloRating[]

  @@map("users")
}

// ============================================
// Modèle Ligue (Organisation)
// ============================================
model League {
  id              String   @id @default(cuid())
  name            String
  description     String?
  inviteCode      String   @unique @default(cuid())
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Propriétaire
  ownerId         String
  owner           User     @relation("LeagueOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Relations
  memberships     LeagueMembership[]
  matches         Match[]
  eloRatings      EloRating[]

  @@map("leagues")
}

// ============================================
// Modèle Appartenance à une Ligue
// ============================================
model LeagueMembership {
  id        String   @id @default(cuid())
  role      String   @default("member") // member, admin, owner
  joinedAt  DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId])
  @@map("league_memberships")
}

// ============================================
// Modèle Match
// ============================================
model Match {
  id            String      @id @default(cuid())
  type          MatchType   // ONE_V_ONE ou TWO_V_TWO
  status        MatchStatus @default(IN_PROGRESS)
  scoreTeamA    Int         @default(0)
  scoreTeamB    Int         @default(0)
  startedAt     DateTime    @default(now())
  finishedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  leagueId      String
  league        League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  // Relations
  players       MatchPlayer[]
  eloChanges    EloChange[]

  @@map("matches")
}

enum MatchType {
  ONE_V_ONE
  TWO_V_TWO
}

enum MatchStatus {
  IN_PROGRESS
  FINISHED
  CANCELLED
}

// ============================================
// Modèle Joueur dans un Match
// ============================================
model MatchPlayer {
  id        String @id @default(cuid())
  team      String // TEAM_A ou TEAM_B
  position  Int    @default(0) // 0 ou 1 pour 2v2

  matchId   String
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@map("match_players")
}

// ============================================
// Modèle Rating Elo
// ============================================
model EloRating {
  id          String   @id @default(cuid())
  rating      Int      @default(1000)
  matchesWon  Int      @default(0)
  matchesLost Int      @default(0)
  winStreak   Int      @default(0)
  bestStreak  Int      @default(0)
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  leagueId    String
  league      League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  // Historique
  changes     EloChange[]

  @@unique([userId, leagueId])
  @@map("elo_ratings")
}

// ============================================
// Modèle Changement Elo
// ============================================
model EloChange {
  id            String   @id @default(cuid())
  ratingBefore  Int
  ratingAfter   Int
  change        Int
  createdAt     DateTime @default(now())

  eloRatingId   String
  eloRating     EloRating @relation(fields: [eloRatingId], references: [id], onDelete: Cascade)

  matchId       String
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("elo_changes")
}

